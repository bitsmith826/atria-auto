# Konfigurasi Atria Auto
# Salin file ini, ubah sesuai kebutuhan kamu.

# URL 9Router kamu (default: lokal)
ROUTER_URL=http://localhost:20128

# Password login 9Router kamu
ROUTER_PASSWORD=***

# true  = browser jalan tersembunyi (background)
# false = browser kelihatan (bisa lihat prosesnya langsung)
HEADLESS=false

# Maksimum buat ulang API key kalau gagal valid di 9Router
MAX_COBA_KEY=5

# Jeda (detik) antar akun, supaya tidak terlalu cepat
JEDA_ANTAR_AKUN=5
